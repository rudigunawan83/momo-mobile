{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "InitialRetryDelayMs": 1000
  },
  "Security": {
    "AesKey": ""
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2",
      "SslProtocols": [ "Tls13" ]
    }
  }
}
